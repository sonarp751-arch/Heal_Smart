# ─────────────────────────────────────────────────────────────────────
#  HealSmart — Environment Variables
#  Copy this file to .env and fill in your keys before running.
# ─────────────────────────────────────────────────────────────────────

# OpenRouter API key — configured server-side in Vercel.
OPENROUTER_API_KEY=

# Model to use  (free tier examples):
#   mistralai/mistral-7b-instruct        ← fastest, free
#   google/gemma-2-9b-it:free            ← good quality, free
#   anthropic/claude-3-haiku             ← best quality, paid
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Shown in OpenRouter usage dashboard
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=HealSmart
